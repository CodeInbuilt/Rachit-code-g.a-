<Query Kind="Program" />

namespace clacution
{
class clacution
{
static void Main(string [] args)
{
Console.WriteLine("Enter of number1:");
int num1 = Convert.ToInt32(Console.ReadLine());
Console.WriteLine("Enter of number2:");
int num2 = Convert.ToInt32(Console.ReadLine());
Console.WriteLine("Enter of number1:"+ num1);
Console.WriteLine("Enter of number2:" + num2); 
Console.WriteLine("press 1 for addtion");
Console.WriteLine("press 2 for sub"); 
Console.WriteLine("press 3 for mul");
Console.WriteLine("press 4 for Div");
switch(press)
{
case 1:
Console.WriteLine(num1+num2);
break;
case 2:
Console.WriteLine(num1-num2);
break;
case 3:
Console.WriteLine(num1*num2);
break;
case 4:
Console.WriteLine(num1/num2);
break;
}
}
}
}
}

