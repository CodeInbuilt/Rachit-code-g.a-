            var patient = hm.GetPatientById(patientId);
            if (patient == null)
            {
                Console.WriteLine("No such patient found.");
            }
            else
            {
                Console.WriteLine("Patient: " + patient.ToString());
                var appts = hm.GetAppointmentsForPatient(patientId);
                if (!appts.Any())
                {
                    Console.WriteLine("No appointments for this patient.");
                }
                else
                {
                    Console.WriteLine("Appointments:");
